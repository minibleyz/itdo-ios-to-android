<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>ru</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>MinimumOSVersion</key>
	<string>17.0</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- ATS: разрешаем itdo.bleyzos.ru по HTTPS, а всё остальное блокируем по умолчанию -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSExceptionDomains</key>
		<dict>
			<key>itdo.bleyzos.ru</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<false/>
				<key>NSIncludesSubdomains</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<!-- Микрофон — для голосовых сообщений -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Нужен для записи голосовых сообщений</string>
	<!-- Фото — для отправки изображений в чате и постах -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Нужна для прикрепления фото к сообщениям и постам</string>
	<!-- Камера — на будущее -->
	<key>NSCameraUsageDescription</key>
	<string>Нужна для съёмки фото и видео</string>
	<!-- Face ID — как альтернатива вводу код-пароля приложения (см. PasscodeSettingsView) -->
	<key>NSFaceIDUsageDescription</key>
	<string>Используется как быстрая альтернатива вводу код-пароля приложения</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleLightContent</string>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
</dict>
</plist>
